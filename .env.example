# Variables d'environnement — Evodron

# Copier ce fichier en `.env` et remplir les valeurs.
# Ne jamais committer `.env` dans le dépôt.

# ── Sécurité ──────────────────────────────────────────────────────────────
# Clé secrète JWT. Utiliser une valeur aléatoire longue (minimum 32 caractères).
# Exemple : openssl rand -hex 32
JWT_SECRET=changeme-use-a-long-random-value-here

# Durée de validité des tokens JWT (défaut : 7d)
# Formats acceptés : "7d", "24h", "3600s"
JWT_EXPIRY=7d

# ── Serveur ───────────────────────────────────────────────────────────────
PORT=3000

# URL publique de l'application (utilisée pour générer les liens de parrainage)
# Exemple : https://app.evodron.com
APP_URL=http://localhost:3000

# ── Base de données ───────────────────────────────────────────────────────
# Chemin vers le fichier SQLite (défaut : ./evodron.db)
# Utiliser :memory: pour les tests uniquement
DB_PATH=./evodron.db

# ── Environnement ─────────────────────────────────────────────────────────
# Valeurs : development | production | test
NODE_ENV=development
