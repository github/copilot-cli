{
  "name": "evodron-repository",
  "version": "1.0.0",
  "description": "Repository entrypoint for the EVODRON platform workspace",
  "private": true,
  "scripts": {
    "setup": "cd evodron && npm ci && npm run build && npm run db:migrate && npm run db:seed",
    "build": "cd evodron && npm run build",
    "test": "cd evodron && npm test",
    "lint": "cd evodron && npm run lint",
    "dev:api": "cd evodron && npm run dev:api",
    "dev:cli": "cd evodron && npm run dev:cli",
    "db:migrate": "cd evodron && npm run db:migrate",
    "db:seed": "cd evodron && npm run db:seed",
    "start": "cd evodron && npm run start --workspace=@evodron/api"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
