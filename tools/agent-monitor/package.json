{
  "name": "copilot-agent-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only terminal viewer for a selected local Copilot CLI session",
  "bin": {
    "agent-monitor": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
