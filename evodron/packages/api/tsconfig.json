{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@evodron/shared": ["../shared/src"],
      "@evodron/db": ["../db/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
