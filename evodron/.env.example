# EVODRON — Environment Variables

# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── API Server ──────────────────────────────────────────────────────────────

# Secret used to sign JWTs. Must be a long, random string (32+ chars).
EVODRON_JWT_SECRET=change-me-to-a-long-random-secret

# Port the API listens on.
EVODRON_API_PORT=3000

# Host the API binds to.
EVODRON_API_HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────

# SQLite: file path (development / small production)
EVODRON_DB_URL=file:./evodron.db

# PostgreSQL: connection string (large production)
# EVODRON_DB_URL=******host:5432/evodron

# ─── Referral System ─────────────────────────────────────────────────────────

# Public base URL for referral links (no trailing slash).
EVODRON_REFERRAL_BASE_URL=https://evodron.io

# Minimum number of completed sessions before a referral is considered "active"
# and rewards are triggered.
EVODRON_REWARD_MIN_SESSIONS=3

# ─── CLI ─────────────────────────────────────────────────────────────────────

# URL of the EVODRON API that the CLI communicates with.
EVODRON_API_URL=http://localhost:3000

# Path to the local config directory (defaults to ~/.evodron if not set).
# EVODRON_CONFIG_DIR=~/.evodron

# ─── Environment ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Logging ─────────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
